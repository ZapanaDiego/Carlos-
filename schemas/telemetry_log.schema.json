{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryLog",
  "description": "Schema for Carlos++ unified logging system",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    },
    "source": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "simulation_step": {
      "description": "The current step in the simulation. Set to null as a sentinel value if the log is emitted outside of an active simulation context (e.g. engine startup, shutdown, or initial parsing).",
      "type": ["integer", "null"]
    }
  },
  "required": [
    "timestamp",
    "level",
    "source",
    "message",
    "metadata",
    "simulation_step"
  ],
  "additionalProperties": false
}
