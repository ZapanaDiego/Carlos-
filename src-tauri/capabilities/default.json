{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Carlos++",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    {
      "identifier": "core:event:allow-listen",
      "allow": [{ "event": "log-entry" }]
    }
  ]
}
